# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Claude Code hooks 시크릿 (Slack 웹훅 URL 등)
# 참고: .env* 패턴이 이미 포함하지만, 명시적으로 명시
.claude/hooks/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP (진단/테스팅용 임시 파일)
.playwright-mcp/

# 스크린샷 (진단용 캡처)
*.png
*.jpg
*.jpeg
